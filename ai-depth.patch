diff --git a/netlify/lib/triage.js b/netlify/lib/triage.js
new file mode 100644
index 0000000..2366927
--- /dev/null
+++ b/netlify/lib/triage.js
@@ -0,0 +1,66 @@
+// The "form" Gemini must fill in for a first-aid case, plus the check that the answer is usable.
+// Keys and the enum values (urgency, photo_quality, confidence) are always English: the app reads them.
+// Every other text value is written by the model in the farmer's language.
+const URGENCY = ['green', 'yellow', 'red'];
+const QUALITY = ['good', 'unclear'];
+const CONFIDENCE = ['probably', 'maybe', 'unsure'];
+const MAX = { conditions: 3, steps: 6, doNot: 4 };
+
+const TRIAGE_SCHEMA = {
+  type: 'OBJECT',
+  properties: {
+    urgency: { type: 'STRING', enum: URGENCY, description: 'green = minor, red = emergency' },
+    animal_visible: { type: 'BOOLEAN', description: 'true only if the animal is clearly visible' },
+    photo_quality: { type: 'STRING', enum: QUALITY },
+    likely_conditions: {
+      type: 'ARRAY', maxItems: MAX.conditions,
+      items: {
+        type: 'OBJECT',
+        properties: {
+          name: { type: 'STRING' },
+          confidence: { type: 'STRING', enum: CONFIDENCE },
+          reason: { type: 'STRING' }
+        },
+        required: ['name', 'confidence', 'reason']
+      }
+    },
+    first_aid_steps: { type: 'ARRAY', maxItems: MAX.steps, items: { type: 'STRING' } },
+    do_not: { type: 'ARRAY', maxItems: MAX.doNot, items: { type: 'STRING' } },
+    call_vet_when: { type: 'STRING' },
+    spoken_summary: { type: 'STRING' }
+  },
+  required: ['urgency', 'animal_visible', 'photo_quality', 'likely_conditions', 'first_aid_steps', 'do_not', 'call_vet_when', 'spoken_summary']
+};
+
+const str = (v) => (typeof v === 'string' ? v.trim() : '');
+const strList = (v, max) => (Array.isArray(v) ? v.map(str).filter(Boolean).slice(0, max) : null);
+
+// Returns a cleaned object, or null if the text is not valid JSON or is missing required parts.
+function parseTriage(text) {
+  let o;
+  try { o = JSON.parse(String(text).replace(/^\s*```(?:json)?\s*|\s*```\s*$/g, '')); } catch { return null; }
+  if (!o || typeof o !== 'object') return null;
+  if (!URGENCY.includes(o.urgency) || !QUALITY.includes(o.photo_quality) || typeof o.animal_visible !== 'boolean') return null;
+
+  const steps = strList(o.first_aid_steps, MAX.steps);
+  const doNot = strList(o.do_not, MAX.doNot);
+  if (!steps || !doNot || !Array.isArray(o.likely_conditions)) return null;
+
+  const conditions = o.likely_conditions.slice(0, MAX.conditions).map((c) => ({
+    name: str(c && c.name),
+    confidence: CONFIDENCE.includes(c && c.confidence) ? c.confidence : 'unsure',
+    reason: str(c && c.reason)
+  })).filter((c) => c.name);
+
+  const out = {
+    urgency: o.urgency, animal_visible: o.animal_visible, photo_quality: o.photo_quality,
+    likely_conditions: conditions, first_aid_steps: steps, do_not: doNot,
+    call_vet_when: str(o.call_vet_when), spoken_summary: str(o.spoken_summary)
+  };
+  // A usable answer needs advice. The only exception: the photo is unusable and the app will ask for a new one.
+  const retake = !out.animal_visible || out.photo_quality === 'unclear';
+  if (!retake && (!out.spoken_summary || !out.first_aid_steps.length || !out.call_vet_when)) return null;
+  return out;
+}
+
+module.exports = { TRIAGE_SCHEMA, parseTriage };
