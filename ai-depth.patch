From 4bd1e346dd28bbea13f06c85a561dd3963c2be4a Mon Sep 17 00:00:00 2001
From: ali <a@b>
Date: Sat, 10 Oct 2026 15:26:47 +0000
Subject: [PATCH 1/3] fix: vendor marked, escape model HTML, double-tap guard,
 TTS number bug, Web Speech fallback

---
 src/index.html                  |  2 +-
 src/js/api.js                   | 10 +++++++-
 src/js/audio.js                 | 20 ++++++++++++---
 src/js/vendor/marked.LICENSE.md | 44 +++++++++++++++++++++++++++++++++
 src/js/vendor/marked.min.js     |  6 +++++
 5 files changed, 77 insertions(+), 5 deletions(-)
 create mode 100644 src/js/vendor/marked.LICENSE.md
 create mode 100644 src/js/vendor/marked.min.js

diff --git a/src/index.html b/src/index.html
index 2368b52..c1cec72 100644
--- a/src/index.html
+++ b/src/index.html
@@ -6,7 +6,7 @@
   <title>مویشی AI - Maweshi AI</title>
   <link rel="icon" href="img/favicon.png" type="image/png">
   <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
-  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
+  <script src="js/vendor/marked.min.js"></script>
   <link rel="stylesheet" href="css/style.css">
 </head>
 <body>
diff --git a/src/js/api.js b/src/js/api.js
index c3f2a37..40a8f7d 100644
--- a/src/js/api.js
+++ b/src/js/api.js
@@ -1,5 +1,12 @@
 // The browser sends only plain inputs; the server builds the prompt and calls Gemini.
+const escapeHtml = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+// Model text is untrusted: HTML is escaped before markdown rendering, and links/images are dropped.
+if (window.marked) marked.use({ renderer: { link: (href, title, text) => text, image: () => '' } });
+
+let busy = false; // ignore double taps while a request is running
 async function callApi(endpoint, body, ui) {
+  if (busy) return;
+  busy = true;
   const loader = document.getElementById(ui.loader);
   const card = document.getElementById(ui.card);
   loader.style.display = 'block';
@@ -13,7 +20,7 @@ async function callApi(endpoint, body, ui) {
     let result;
     try { result = await response.json(); } catch { throw new Error('Server error'); }
     if (!response.ok || !result.text) throw new Error(result.error || 'Request failed');
-    document.getElementById(ui.out).innerHTML = marked.parse(result.text);
+    document.getElementById(ui.out).innerHTML = marked.parse(escapeHtml(result.text));
     card.style.display = 'block';
     card.scrollIntoView({ behavior: 'smooth', block: 'start' });
   } catch (err) {
@@ -21,6 +28,7 @@ async function callApi(endpoint, body, ui) {
     alert(t('errGeneric'));
   } finally {
     loader.style.display = 'none';
+    busy = false;
   }
 }
 
diff --git a/src/js/audio.js b/src/js/audio.js
index 6a1608c..4f28f2b 100644
--- a/src/js/audio.js
+++ b/src/js/audio.js
@@ -10,6 +10,7 @@ function setSpeakUI(btn, playing) {
 function stopSpeech() {
   speakToken++;
   if (window.currentAudio) { window.currentAudio.pause(); window.currentAudio = null; }
+  if (window.speechSynthesis) speechSynthesis.cancel();
   setSpeakUI(speakBtn, false);
   speakBtn = null;
 }
@@ -24,7 +25,8 @@ function speakHelp(key, btn) { speak(t(key), btn); }
 function speak(rawText, btn) {
   if (btn && btn === speakBtn) { stopSpeech(); return; }   // second tap = stop
   stopSpeech();
-  const cleanText = (rawText || '').replace(/[\*\#\-\_]/g, '').replace(/[0-9]\./g, '').trim();
+  // Remove list markers ("1.", "-", "*") and markdown symbols, but keep numbers like 2.5 intact.
+  const cleanText = (rawText || '').replace(/^\s*(?:[-*\u2022]|\d+[.)])\s+/gm, '').replace(/[*#_`>]/g, '').replace(/\n+/g, '. ').trim();
   if (!cleanText) return;
 
   // Google TTS has no Balochi, Hindko, Saraiki or Shahmukhi-Punjabi voice, so those use the Urdu voice (MVP).
@@ -44,8 +46,20 @@ function speak(rawText, btn) {
     const audio = new Audio(`/api/tts?q=${encodeURIComponent(chunk)}&tl=${langCode}`);
     window.currentAudio = audio;
     audio.onended = next;
-    audio.onerror = () => { if (myToken === speakToken) stopSpeech(); };
-    audio.play().catch(() => { if (myToken === speakToken) stopSpeech(); });
+    // If the server voice fails, fall back to the browser's own voice for the rest of the text.
+    let failed = false;
+    const fallback = () => { if (failed || myToken !== speakToken) return; failed = true; webSpeak(chunks.slice(i - 1).join(' '), langCode, myToken); };
+    audio.onerror = fallback;
+    audio.play().catch(fallback);
   }
   next();
 }
+
+// Fallback voice: the browser's built-in Web Speech API. A voice for the language may not be installed.
+function webSpeak(text, langCode, myToken) {
+  if (!window.speechSynthesis || !text.trim()) { stopSpeech(); return; }
+  const u = new SpeechSynthesisUtterance(text);
+  u.lang = { en: 'en-US', sd: 'sd-PK', ps: 'ps-AF' }[langCode] || 'ur-PK';
+  u.onend = u.onerror = () => { if (myToken === speakToken) stopSpeech(); };
+  speechSynthesis.speak(u);
+}
